/vendor/
/.env

# Claude Code's per-machine settings: absolute paths and tool allow-lists that
# mean nothing on anyone else's box. A shared .claude/settings.json is fine.
/.claude/settings.local.json
/storage/uploads/*
!/storage/uploads/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep

# composer.lock IS committed. This is an application, not a library: the lock
# file is what makes `composer install` on a server produce the same PHPMailer
# every time, rather than whatever happens to be current that day. It was
# ignored while the project had no runtime packages at all.

.DS_Store
Thumbs.db
*.log

# Generated by tests/qr-encode.php — open it in a browser to run the round trip.
# Regenerated on every run, so there is nothing to keep in the repository.
/tests/qr-encode-output.html
