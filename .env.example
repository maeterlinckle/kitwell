# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Application
APP_NAME="Kitwell"
APP_ENV=production            # local | production
APP_DEBUG=false               # true only on a development machine
APP_URL=https://assets.example.com
APP_TIMEZONE=Europe/London
APP_CURRENCY=GBP
APP_CURRENCY_SYMBOL="£"

# Encryption key for secrets stored in the database — today only the SMTP
# password. Generate one with `php bin/console.php key:generate`.
# Changing it makes the stored SMTP password unreadable; it would have to be
# re-entered in Settings → Email. Back it up with the database, not instead of it.
APP_KEY=

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kitwell
DB_USERNAME=kitwell
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Sessions / security
SESSION_NAME=kitwell_session
SESSION_LIFETIME=480          # minutes of inactivity before the session expires
SESSION_SAMESITE=Lax          # Lax | Strict
FORCE_HTTPS=true              # redirect http -> https and set Secure cookie flag
TRUST_PROXY=true              # honour X-Forwarded-Proto/For from the reverse proxy

# Login throttling
LOGIN_MAX_ATTEMPTS=5          # failed attempts before lockout
LOGIN_DECAY_MINUTES=15        # window the attempts are counted over
LOGIN_LOCKOUT_MINUTES=15      # how long an account/IP stays locked out

# Outbound email
# Everything else — host, port, encryption, from address — is configured in
# Settings → Email and stored in the database. Only the password can live here,
# for a site that would rather keep it out of the database entirely. When it is
# set, it wins over whatever is stored, and the Settings page says so.
# Leave blank to manage the password from the Settings page instead.
MAIL_PASSWORD=

# Uploads
UPLOAD_MAX_PHOTO_MB=10
UPLOAD_MAX_PDF_MB=25
STORAGE_PATH=storage          # relative to the project root, or an absolute path
